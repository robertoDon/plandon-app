# Copy to .env.local (git-ignored). Local values: npx supabase status -o env
# Browser: URL + anon key only.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
# Scripts and tests only. Never ship to the browser, never commit.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Admin user the loader creates (role don, person beto). Use a real address and password only in your own .env.local.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
